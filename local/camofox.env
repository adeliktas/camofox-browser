# Sourced by local/camofox-ctl, local/selfcheck.mjs (via ctl) and local/openrc/camofox-browser.
# Port 8788 keeps the number the old camoufox-mcp daemon used, so agent notes stay valid.
REPO=${REPO:-$HOME/gitrepos/securityrepos/camofox-browser}
: "${CAMOFOX_PORT:=8788}"; export CAMOFOX_PORT
: "${CAMOFOX_BIND_HOST:=127.0.0.1}"; export CAMOFOX_BIND_HOST
export CAMOFOX_CRASH_REPORT_ENABLED=false
# Visible window, like the old camoufox-mcp daemon had: a human can watch and
# take over. Without X (no DISPLAY) camofox falls back to headless on its own.
: "${CAMOFOX_INTERACTIVE:=desktop}"; export CAMOFOX_INTERACTIVE
: "${DISPLAY:=:0}"; export DISPLAY
: "${CAMOFOX_PROFILE_DIR:=$HOME/.local/share/camofox-browser/profiles}"; export CAMOFOX_PROFILE_DIR
export CAMOFOX_COOKIES_DIR=$HOME/.local/share/camofox-browser/cookies
export CAMOFOX_TRACES_DIR=$HOME/.local/share/camofox-browser/traces
export CAMOFOX_UPLOADS_DIR=$HOME/.local/share/camofox-browser/uploads
: "${CAMOFOX_STATE_DIR:=$HOME/.local/share/camofox-browser}"; export CAMOFOX_STATE_DIR
# Stable identity: the MCP proxy hashes a random uuid per process by default,
# which would give every agent session its own cookies. One user = one session.
: "${CAMOFOX_USER_ID:=pi}"; export CAMOFOX_USER_ID
